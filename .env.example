# Copy to .env.local and fill in real values. Never commit .env.local.
# Values come from Supabase Dashboard → Project Settings → API Keys.

# Project URL, e.g. https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable ("sb_publishable_...") key — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret ("sb_secret_..." / service_role) key — bypasses Row Level Security.
# Server-only: never prefix with NEXT_PUBLIC_ and never import into a Client Component.
SUPABASE_SERVICE_ROLE_KEY=

# Public origin used for canonical URLs and metadata. Optional in development.
NEXT_PUBLIC_SITE_URL=

# ── Resend (transactional email) ────────────────────────────────────────────
# Notifies the clinic when a patient books an appointment or submits the
# contact form. Admin-side actions never send email.
# Key from https://resend.com/api-keys — server-only, never NEXT_PUBLIC_.
RESEND_API_KEY=

# Sender address, in "Name <address@domain>" form. Must be a Resend-verified
# domain to reach real recipients; `onboarding@resend.dev` is a test sender
# that only delivers to your own Resend account address.
RESEND_FROM_EMAIL=

# Optional. Notification recipient. Defaults to CONTACT_EMAIL (lib/site-config.ts).
ADMIN_NOTIFICATION_EMAIL=
